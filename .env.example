# --- Spotify OAuth ---------------------------------------------------------
# Register the app at https://developer.spotify.com/dashboard with a Premium
# account. Development Mode allows 5 allowlisted users.
# IMPORTANT: "localhost" is rejected by Spotify. Use 127.0.0.1 in development.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/spotify/callback

# --- OpenRouter ------------------------------------------------------------
# Only needed for the OAuth PKCE "Connect OpenRouter" flow; users may also
# paste their own key. Never put a user key here.
OPENROUTER_REDIRECT_URI=http://127.0.0.1:3000/api/auth/openrouter/callback

# --- Database --------------------------------------------------------------
DATABASE_URL=

# --- Secrets ---------------------------------------------------------------
# 32 bytes, base64. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
SESSION_SECRET=

# --- Internal --------------------------------------------------------------
# Shared secret used to authenticate job tick/sweep calls to our own API.
JOB_RUNNER_SECRET=
